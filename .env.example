# App-Stock ahora usa SQLite: no requiere configuración para funcionar.
# Por defecto la base se guarda en %LOCALAPPDATA%\App-Stock\app_stock.db
# (fuera de la carpeta del proyecto, para evitar problemas si el proyecto
# está sincronizado con OneDrive/Drive/Dropbox).
#
# Solo si querés forzar otra ubicación, descomentá y completá esta variable:
# APP_STOCK_DB_PATH=C:\ruta\a\otra\carpeta\app_stock.db
